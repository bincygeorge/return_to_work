<%= form_with model: planner_item do |form| %>
  <% if planner_item.errors.any? %>
    <div class="error-messages">
      <h3>Please correct the following:</h3>
      <ul>
        <% planner_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "Activity" %>
    <%= form.text_field :title, placeholder: "e.g. Practise Ruby arrays", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Notes (optional)" %>
    <%= form.text_area :description, rows: 3, placeholder: "What would you like to accomplish?" %>
  </div>

  <div class="form-group">
    <%= form.label :category %>
    <%= form.select :category,
                    PlannerItem::CATEGORIES.map { |category| [category, category] },
                    { prompt: "Choose a category" },
                    { required: true } %>
  </div>

  <div class="form-group">
    <%= form.label :scheduled_date, "Date" %>
    <%= form.date_field :scheduled_date, required: true %>
  </div>

  <div class="form-group">
    <%= form.label :start_time, "Start time" %>
    <%= form.time_field :start_time, required: true %>
  </div>

  <div class="form-group">
    <%= form.label :end_time, "End time" %>
    <%= form.time_field :end_time, required: true %>
  </div>

  <div class="form-actions">
    <%= form.submit "Save activity", class: "btn btn-primary" %>
    <%= link_to "Cancel", root_path, class: "btn btn-secondary" %>
  </div>
<% end %>