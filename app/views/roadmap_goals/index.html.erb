
<div class="roadmap-layout">
  <section class="goals-section">
    <div class="page-heading">
      <h1>My Career Roadmap</h1>
      <p>Your next chapter starts with one small step.</p>

      <%= link_to "＋ Add a Career Goal",
                  new_roadmap_goal_path,
                  class: "button" %>
    </div>

<div class="roadmap-layout">
    <% if @roadmap_goals.any? %>
      <% @roadmap_goals.each do |goal| %>
        <article class="goal-card">
          <div class="goal-card-header">
            <span class="goal-category"><%= goal.category %></span>
            <span class="goal-status">
              <%= goal.status.humanize %>
            </span>
          </div>

          <h2><%= goal.title %></h2>

          <% if goal.description.present? %>
            <p><%= goal.description %></p>
          <% end %>

          <% if goal.target_date.present? %>
            <p class="goal-date">
              Target date: <%= goal.target_date.strftime("%d %b %Y") %>
            </p>
          <% end %>

          <div class="goal-actions">
            <%= link_to "Edit", edit_roadmap_goal_path(goal) %>

            <%= button_to "Delete",
                          roadmap_goal_path(goal),
                          method: :delete,
                          form: {
                            data: {
                              turbo_confirm: "Are you sure you want to delete this goal?"
                            }
                          } %>
          </div>
        </article>
      <% end %>
    <% else %>
      <article class="empty-state">
        <h2>Your journey starts here 🌱</h2>
        <p>Add your first career goal and take one small step towards your future.</p>
      </article>
    <% end %>
  </section>

  <aside class="motivation-panel">
    <div class="plant-icon" aria-hidden="true">🌱</div>

    <p class="panel-label">A LITTLE ENCOURAGEMENT</p>

    <blockquote>
      “<%= @daily_quote[:text] %>”
    </blockquote>

    <p class="quote-author">
      — <%= @daily_quote[:author] %>
    </p>

    <hr>

    <p class="gentle-reminder">
      You don't have to do everything today.
      One small step is enough.
    </p>
  </aside>
</div>
<section class="weekly-planner">
  <div class="planner-header">
    <div>
      <h2>My Weekly Planner</h2>
      <p>Small steps, steady progress.</p>
    </div>

    <%= link_to "＋ Add Activity", new_planner_item_path,
                class: "btn btn-primary" %>
  </div>
  <div class="weekly-progress">
    <div class="progress-heading">
      <h3>Your Weekly Progress 🌱</h3>

      <span>
        <%= @completed_activities %> of
        <%= @total_activities %> activities completed
      </span>
    </div>

    <div class="progress-track">
      <div
        class="progress-fill"
        style="width: <%= @progress_percentage %>%;">
      </div>
    </div>

    <p class="progress-percentage">
      <%= @progress_percentage %>% complete
    </p>
  </div>
  <p class="planner-week">
    <%= @week_start.strftime("%B %d") %> –
    <%= @week_end.strftime("%B %d, %Y") %>
  </p>

  <% if @planner_items.any? %>
    <% @planner_items.group_by(&:scheduled_date).each do |date, items| %>
      <div class="planner-day">
        <h3>
          <%= date.strftime("%A, %B %d") %>
        </h3>

        <% items.each do |item| %>
          <div class="planner-item">
            <div>
              <div class="planner-item-title">
                <%= form_with(
                      model: item,
                      url: planner_item_path(item),
                      method: :patch
                    ) do |form| %>

                  <%= form.hidden_field :completed, value: "0" %>

                  <%= form.check_box :completed,
                                     { onchange: "this.form.requestSubmit()" },
                                     "1",
                                     "0" %>

                  <strong class="<%= 'completed-task' if item.completed? %>">
                    <%= item.title %>
                  </strong>

                <% end %>
              </div>
              <p><%= item.category %></p>
              <small>
                <%= item.start_time.strftime("%H:%M") %> –
                <%= item.end_time.strftime("%H:%M") %>
              </small>
            </div>

            <div class="planner-actions">
              <%= link_to "Edit", edit_planner_item_path(item) %>
              <%= button_to "Delete", planner_item_path(item),
                            method: :delete,
                            form: { data: { turbo_confirm: "Delete this activity?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="planner-empty">
      <h3>Your week starts with one small step 🌱</h3>
      <p>Add a learning goal, job-search task, family activity or moment for yourself.</p>

      <%= link_to "Plan my first activity", new_planner_item_path,
                  class: "btn btn-primary" %>
    </div>
  <% end %>
</section>